// Переключение вкладок (экранов)
function switchScreen(screenId, btn) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
    
    document.getElementById(screenId).classList.add('active');
    btn.classList.add('active');
}

// Переключение языков
function changeLanguage(lang) {
    const dict = langData[lang];
    for (let id in dict) {
        const el = document.getElementById(id);
        if (el) {
            if (el.tagName === 'INPUT') el.placeholder = dict[id];
            else el.innerText = dict[id];
        }
    }
}

// Кнопка Подключения ВПН (имитация действия)
let isConnected = false;
function toggleConnect() {
    const btn = document.getElementById('btn-connect');
    const statusTxt = document.getElementById('txt-connect-status');
    const pingTxt = document.getElementById('val-ping');
    
    isConnected = !isConnected;
    
    if (isConnected) {
        btn.classList.remove('disconnected');
        btn.classList.add('connected');
        statusTxt.innerText = "Подключено";
        statusTxt.style.color = "#4caf50";
        pingTxt.innerText = "42 ms";
        tg.HapticFeedback.notificationOccurred("success"); // Вибрация на телефоне
    } else {
        btn.classList.remove('connected');
        btn.classList.add('disconnected');
        statusTxt.innerText = "Отключено";
        statusTxt.style.color = "#fff";
        pingTxt.innerText = "-- ms";
        tg.HapticFeedback.notificationOccurred("warning");
    }
}

// Выбор локации
function selectLocation(element, country) {
    document.querySelectorAll('.location-item').forEach(item => item.classList.remove('active'));
    element.classList.add('active');
    if (isConnected) {
        // Если подключен — переподключаем имитацию для обновления пинга
        toggleConnect(); toggleConnect();
    }
}

// Копирование ключей в буфер обмена
function copyKey(id) {
    const text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text).then(() => {
        alert("Ключ скопирован в буфер обмена!");
    });
}


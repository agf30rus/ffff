// Функция переключения языков
function changeLanguage(lang) {
    const langData = translations[lang];
    for (let key in langData) {
        const element = document.getElementById(key);
        if (element) {
            if (element.tagName === 'INPUT' || element.tagName === 'BUTTON' && element.id === 'btn-buy') {
                element.innerText = langData[key];
            } else {
                element.innerText = langData[key];
            }
        }
    }
}

// Функция переключения вкладок нижней навигации
function switchTab(tabId, button) {
    // Скрываем все вкладки
    document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
    // Убираем активный класс у кнопок меню
    document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));
    
    // Показываем нужную вкладку и активируем кнопку
    document.getElementById(tabId).classList.add('active');
    button.classList.add('active');

    // Если ушли со вкладки камер, останавливаем плеер, чтобы не тратить трафик
    if (tabId !== 'tab-cams') {
        const video = document.getElementById('video-player');
        video.pause();
    }
}

// Функция запуска трансляции дорожной камеры
function playCamera(videoSrc) {
    const video = document.getElementById('video-player');
    if (!videoSrc) return;

    if (Hls.isSupported()) {
        const hls = new Hls();
        hls.loadSource(videoSrc);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, function() {
            video.play();
        });
    } 
    // Встроенная поддержка HLS (для iOS / Safari на Айфонах)
    else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = videoSrc;
        video.addEventListener('loadedmetadata', function() {
            video.play();
        });
    }
}

